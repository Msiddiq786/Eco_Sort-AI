# EcoSort AI Frontend Environment Template
# Copy to .env.local for local overrides (never commit .env.local).
# Leave empty when using Vite dev proxy (`npm run dev` proxies /api -> http://localhost:8000).
# On Vercel production, set VITE_API_URL to your deployed FastAPI backend origin:
#   VITE_API_URL=https://ecosort-ai-backend.onrender.com

VITE_API_URL=
