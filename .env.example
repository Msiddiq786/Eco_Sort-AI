# ── EcoSort AI — Master Environment Configuration Template ────────────
# Copy this file to .env in your root or backend directory.
# NEVER commit .env to Git.

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# CORS Configuration (allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (SQLite async connection)
DATABASE_URL=sqlite+aiosqlite:///./waste_segregation.db

# File Upload Policies
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "webp", "bmp"]

# Machine Learning Models Directory & Checkpoints
MODELS_DIR=models
VIT_CHECKPOINT=google/vit-base-patch16-224-in21k
VIT_FINETUNED_PATH=models/vit_waste_best.pt
CLIP_CHECKPOINT=openai/clip-vit-base-patch32

# Ensemble Calibration & Fusion Weights (must sum to 1.0)
ENSEMBLE_VIT_WEIGHT=0.70
ENSEMBLE_CLIP_WEIGHT=0.30

# Semantic Versioning
MODEL_VERSION=1.0.0
