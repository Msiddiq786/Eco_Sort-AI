# ── EcoSort AI — Master Environment Configuration Template ────────────
# Copy this file to .env in your root or backend directory for local development.
# Set variables directly in Railway / Render / Vercel dashboards in production.
# NEVER commit real secrets, tokens, or .env files to Git.

# Environment & Server Configuration
ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
ENABLE_DOCS=true

# CORS Configuration (JSON array OR comma-separated origins)
# Production example: https://your-frontend.vercel.app
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional regex for Vercel preview deployments (leave empty unless needed):
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# Database Configuration
# Local / Persistent Disk SQLite: sqlite+aiosqlite:///./waste_segregation.db (or sqlite+aiosqlite:////data/waste_segregation.db)
# Managed PostgreSQL (Railway / Supabase / Render): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./waste_segregation.db

# File Upload Policies
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
ALLOWED_EXTENSIONS=["jpg","jpeg","png","webp","bmp"]

# Machine Learning Models & Cloud Hub Bootstrap
MODELS_DIR=models
VIT_CHECKPOINT=google/vit-base-patch16-224-in21k
VIT_FINETUNED_PATH=models/vit_waste_best.pt
CLIP_CHECKPOINT=openai/clip-vit-base-patch32
CLIP_ENABLED=true

# Automatic Hub model download for stateless Git deployments (when local weights aren't baked into image)
AUTO_DOWNLOAD_MODELS=true
# Optional Hugging Face repo containing fine-tuned ViT checkpoint files (config.json, model.safetensors, preprocessor_config.json):
VIT_HF_REPO_ID=
VIT_HF_SUBFOLDER=
TRASH_SEG_HF_REPO_ID=turhancan97/yolov8-segment-trash-detection
# Optional HF token ONLY if VIT_HF_REPO_ID is private:
HF_TOKEN=

# Ensemble Calibration & Fusion Weights (must sum to 1.0)
ENSEMBLE_VIT_WEIGHT=0.70
ENSEMBLE_CLIP_WEIGHT=0.30

# Semantic Versioning
MODEL_VERSION=1.0.0
