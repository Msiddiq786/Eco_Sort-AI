# ── Smart Waste Segregation — Backend Environment Template ─────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# CORS — add your frontend origin
CORS_ORIGINS=["http://localhost:5173"]

# Database (SQLite — path relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./waste_segregation.db

# File upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# ML Models
MODELS_DIR=models
VIT_CHECKPOINT=google/vit-base-patch16-224-in21k
VIT_FINETUNED_PATH=models/vit_waste_best.pt
CLIP_CHECKPOINT=openai/clip-vit-base-patch32

# Ensemble weights (must sum to 1.0)
ENSEMBLE_VIT_WEIGHT=0.70
ENSEMBLE_CLIP_WEIGHT=0.30

# App version (used for model versioning in DB)
MODEL_VERSION=1.0.0
