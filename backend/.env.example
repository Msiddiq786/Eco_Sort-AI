# ── Smart Waste Segregation — Backend Environment Template ─────────────
# Copy this file to backend/.env for local overrides, or set in Railway/Render dashboard.
# NEVER commit .env to Git.

ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
ENABLE_DOCS=true

# CORS — comma-separated or JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ORIGIN_REGEX=

# Database (SQLite or PostgreSQL via postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./waste_segregation.db

# File upload & active learning
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
FEEDBACK_DIR=data/feedback
ALLOWED_EXTENSIONS=["jpg","jpeg","png","webp","bmp"]

# ML Models & Cloud Bootstrap
MODELS_DIR=models
VIT_CHECKPOINT=google/vit-base-patch16-224-in21k
VIT_FINETUNED_PATH=models/vit_waste_best.pt
CLIP_CHECKPOINT=openai/clip-vit-base-patch32
CLIP_ENABLED=true
AUTO_DOWNLOAD_MODELS=true
VIT_HF_REPO_ID=
VIT_HF_SUBFOLDER=
TRASH_SEG_HF_REPO_ID=turhancan97/yolov8-segment-trash-detection
HF_TOKEN=

# Ensemble weights (must sum to 1.0)
ENSEMBLE_VIT_WEIGHT=0.70
ENSEMBLE_CLIP_WEIGHT=0.30

# App version (used for model versioning in DB)
MODEL_VERSION=1.0.0
